<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AdminOrgName>xperiencecommunity-usageapplications</AdminOrgName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Kentico.Xperience.Admin" Version="31.9.1" />
  </ItemGroup>

  <PropertyGroup>
    <Title>Xperience by Kentico Usage Applications</Title>
    <PackageId>XperienceCommunity.UsageApplications</PackageId>
    <Version>0.0.0</Version>
    <Authors>BlueModus</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>kentico xperience admin content-types widgets usage reports</PackageTags>
    <Description>Admin applications for Xperience by Kentico that report how many content items use each content type and where each Page Builder widget is used.</Description>
    <RepositoryUrl>https://github.com/matiaspenelabm/xperience-community-usage-applications</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>docs\README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>
